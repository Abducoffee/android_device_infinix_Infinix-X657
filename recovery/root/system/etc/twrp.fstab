# TWRP fstab with display flags

# Dynamic partitions
/system         ext4    system                    flags=display="System";logical;first_stage_mount;avb=vbmeta_system
/vendor         ext4    vendor                    flags=display="Vendor";logical;first_stage_mount;avb=vbmeta_vendor
/product        ext4    product                   flags=display="Product";logical;first_stage_mount;avb=vbmeta_system

# Data with encryption support
/data           ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata     flags=display="Data";backup=1;length=-16384

# Metadata for encryption
/metadata       ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/metadata     flags=display="Metadata"

# Cache
/cache          ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache         flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset

# Boot partitions
/boot           emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot          flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1

# Firmware
/lk             emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk             flags=display="LK";backup=1;flashimg=1
/lk2            emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk2            flags=display="LK2";backup=1;flashimg=1
/tee1           emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee1           flags=display="TEE1";backup=1;flashimg=1
/tee2           emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee2           flags=display="TEE2";backup=1;flashimg=1
/logo           emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo           flags=display="Logo";backup=1;flashimg=1
/dtbo           emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1

# AVB partitions
/vbmeta         emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta_system  flags=display="VBMeta_System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta_vendor  flags=display="VBMeta_Vendor";backup=1;flashimg=1

# Important backup partitions
/nvram          emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram          flags=display="NVRAM";backup=1;flashimg=1
/nvdata         ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata         flags=display="NVData";backup=1
/proinfo        emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo        flags=display="ProInfo";backup=1
/protect_f      ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1       flags=display="Protect_F";backup=1
/protect_s      ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2       flags=display="Protect_S";backup=1
/persist        ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/persist        flags=display="Persist";backup=1
/secro          emmc    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro          flags=display="SecRo";backup=1;flashimg=1
/tranfs         ext4    /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tranfs         flags=display="Tranfs";backup=1

# Removable storage
/sdcard1        auto    /dev/block/mmcblk1p1      flags=display="MicroSD";storage;wipeingui;removable
/usb-otg        auto    /dev/block/sda1           flags=display="USB-OTG";storage;wipeingui;removable
