# Dynamic partitions
/system         ext4    system      flags=display=System;logical;first_stage_mount;avb=vbmeta_system
/vendor         ext4    vendor      flags=display=Vendor;logical;first_stage_mount;avb=vbmeta_vendor
/product        ext4    product     flags=display=Product;logical;first_stage_mount;avb=vbmeta_system

# Metadata
/metadata       ext4    /dev/block/platform/bootdevice/by-name/metadata    flags=display="Metadata"

# AVB partitions
/vbmeta         emmc    /dev/block/platform/bootdevice/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system  flags=display="VBMeta_System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor  flags=display="VBMeta_Vendor";backup=1;flashimg=1

# User partitions
/data           f2fs    /dev/block/platform/bootdevice/by-name/userdata    flags=display="Data";backup=1;length=-16384
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache       flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset

# Boot partitions
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot        flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery    flags=display="recovery";backup=1;flashimg=1

# Device specific
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist     flags=display=Persist
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata      flags=display=NVData
/nvram          emmc    /dev/block/platform/bootdevice/by-name/nvram          flags=display="NVRAM";backup=1;flashimg=1
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata         flags=display="NVData";backup=1
/proinfo        emmc    /dev/block/platform/bootdevice/by-name/proinfo        flags=display="ProInfo";backup=1
/protect_f      ext4    /dev/block/platform/bootdevice/by-name/protect1       flags=display="Protect_F";backup=1
/protect_s      ext4    /dev/block/platform/bootdevice/by-name/protect2       flags=display="Protect_S";backup=1
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist        flags=display="Persist";backup=1
/secro          emmc    /dev/block/platform/bootdevice/by-name/secro          flags=display="SecRo";backup=1;flashimg=1
/tranfs         ext4    /dev/block/platform/bootdevice/by-name/tranfs         flags=display="Tranfs";backup=1

# External storage
/external_sd    vfat    /dev/block/mmcblk1p1    flags=display=SDCard;storage;removable
/usb-otg        vfat    /dev/block/sda1         flags=display=USBOTG;storage;removable