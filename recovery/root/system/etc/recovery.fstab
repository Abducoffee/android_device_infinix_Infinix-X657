# Dynamic partitions
/system         ext4    system      flags=display=System;logical
/vendor         ext4    vendor      flags=display=Vendor;logical
/product        ext4    product     flags=display=Product;logical

# Metadata
/metadata       ext4    /dev/block/platform/bootdevice/by-name/md_udc

# User partitions
/data           f2fs    /dev/block/platform/bootdevice/by-name/userdata    flags=display=Data;encryptable=footer
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache       flags=display=Cache

# Boot partitions
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery

# Device specific
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist     flags=display=Persist
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata      flags=display=NVData

# External storage
/external_sd    vfat    /dev/block/mmcblk1p1    flags=display=SDCard;storage;removable
