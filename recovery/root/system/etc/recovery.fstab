# Android fstab file
# mount_point  fstype  device  device2  flags

# Dynamic partitions (logical inside super)
system       /system        ext4   ro,barrier=1   wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb
vendor       /vendor        ext4   ro,barrier=1   wait,avb=vbmeta_vendor,logical,first_stage_mount
product      /product       ext4   ro,barrier=1   wait,avb=vbmeta_system,logical,first_stage_mount

# Core partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/metadata    /metadata    ext4   noatime,nosuid,nodev,discard   wait,check,formattable,first_stage_mount
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata    /data        ext4   noatime,nosuid,nodev,discard,noauto_da_alloc   wait,check,formattable,length=-16384
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache       /cache       ext4   noatime,nosuid,nodev,discard   wait,check

# Protected partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1    /protect_f   ext4   noatime,nosuid,nodev   wait
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2    /protect_s   ext4   noatime,nosuid,nodev   wait
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/persist     /persist     ext4   noatime,nosuid,nodev   wait
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata      /nvdata      ext4   noatime,nosuid,nodev   wait

# EMMC partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot        /boot        emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery    /recovery    emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk          /lk          emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk2         /lk2         emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo        /logo        emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee1        /tee1        emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee2        /tee2        emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/dtbo        /dtbo        emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro       /secro       emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram       /nvram       emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo     /proinfo     emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta             /vbmeta             emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta_system      /vbmeta_system      emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vbmeta_vendor      /vbmeta_vendor      emmc   defaults   defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tranfs      /tranfs      ext4   noatime,nosuid,nodev   wait

# Removable storage
/dev/block/mmcblk1p1    /sdcard1    auto   defaults   voldmanaged=sdcard1:auto
/dev/block/sda1         /usb-otg    auto   defaults   voldmanaged=usb:auto
