# Logical Partitions
system       /system      ext4    display="System";logical
vendor       /vendor      ext4    display="Vendor";logical
product      /product     ext4    display="Product";logical

# Physical Partitions
/metadata     emmc    /dev/block/by-name/metadata     flags=display="Metadata"
/nvram        emmc    /dev/block/by-name/nvram        flags=display="NVRAM";backup=1;flashimg=1
/nvdata       ext4    /dev/block/by-name/nvdata       flags=display="NVData";backup=1
/persist      ext4    /dev/block/by-name/persist      flags=display="Persist";backup=1
/boot         emmc    /dev/block/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery     emmc    /dev/block/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/cache        ext4    /dev/block/by-name/cache        flags=display="Cache"
/userdata     ext4    /dev/block/by-name/userdata     flags=fileencryption=aes-256-cts:aes-256-xts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/logo         emmc    /dev/block/by-name/logo         flags=display="Logo";backup=1;flashimg=1
/vbmeta       emmc    /dev/block/by-name/vbmeta       flags=display="VBMeta";backup=1;flashimg=1
/external_sd  vfat    /dev/block/mmcblk1p1            flags=display="MicroSD";storage;wipeui;removable
